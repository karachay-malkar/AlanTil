{
  "expo": {
    "name": "Alan Til",
    "slug": "alan-til",
    "version": "16.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "alantil",
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "app.alantil.mobile",
      "versionCode": 40,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "alantil",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#fcf7f1",
        "foregroundImage": "./assets/branding/alantil-adaptive-foreground.png"
      }
    },
    "ios": {
      "bundleIdentifier": "app.alantil.mobile",
      "buildNumber": "40"
    },
    "extra": {
      "releaseVersion": "16.7.0",
      "architecture": "shared-core-16.7.0",
      "preview": "expo-web-and-native-preview"
    },
    "icon": "./assets/branding/alantil-icon.png"
  }
}
