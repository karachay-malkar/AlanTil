{
  "expo": {
    "name": "Alan Til",
    "slug": "alan-til",
    "version": "16.6.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "alantil",
    "icon": "./assets/osuyat.png",
    "splash": {
      "image": "./assets/osuyat.png",
      "resizeMode": "contain",
      "backgroundColor": "#fcf8f1"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/osuyat.png"
    },
    "android": {
      "package": "app.alantil.mobile",
      "versionCode": 32,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "alantil",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/osuyat.png",
        "backgroundColor": "#fcf8f1"
      }
    },
    "ios": {
      "bundleIdentifier": "app.alantil.mobile",
      "buildNumber": "32"
    },
    "extra": {
      "releaseVersion": "16.6.7",
      "architecture": "web-13.15.12-shared-core",
      "preview": "expo-web-and-native-preview"
    }
  }
}
